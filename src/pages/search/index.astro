---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchIsland from '@/components/SearchIsland.tsx';
import { buildSearchData } from '@/tools/registry';
import { hotTools, prepareIndex } from '@/lib/search';

const data = buildSearchData();
const total = data.n.length;

// SSR 期先算一次热门，用途有二：
//   1. 首屏不空白；2. 无 JS 时页面仍有可点的内容（搜索页本身 noindex，纯体验问题）
const hot = hotTools(prepareIndex(data), 12);

/** 内联索引：只转义 < 即可，避免 </script> 提前闭合；其余保持原样以控制体积 */
const indexJson = JSON.stringify(data).replace(/</g, '\\u003c');

const qRaw = (Astro.url.searchParams.get('q') || '').slice(0, 64);
const title = qRaw ? `搜索：“${qRaw}”` : '搜索工具 - 站内全部在线工具按名称与关键词查找';
const description =
  '在摩卡工具箱按名称、分类、关键词或拼音搜索你需要的在线工具：密码生成、单位换算、个税计算、JSON 格式化、图片压缩、时间戳转换等，输入即出结果，全程在浏览器本地完成。';
---

{/*
  ⚠️ 必须 noindex：站内搜索页是典型的「无收录价值」页面，
  内容随查询参数变化但 URL 不变，会被判定为 thin content（低质内容）拉低整站权重。
  robots.txt 里已不再 Disallow 本页（Disallow 会让爬虫读不到 noindex，
  反而出现「已索引但无描述」的尴尬结果），去索引完全交给这个 meta。
*/}
<BaseLayout title={title} description={description} path="/search/" noindex={true}>
  <section class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="mb-1 text-2xl font-bold">搜索工具</h1>
    <p class="mb-4 text-sm text-base-content/60">
      全站共 {total} 个工具 · 支持拼音与英文关键词 · 纯本地检索，不上传搜索词
    </p>

    <SearchIsland client:load hot={hot} initialQuery={qRaw} total={total} />

    <noscript>
      <p class="mt-6 text-sm opacity-70">
        搜索需要启用 JavaScript。你也可以<a href="/tools/" class="text-primary hover:underline"
          >直接浏览全部 {total} 个工具</a
        >。
      </p>
    </noscript>
  </section>
</BaseLayout>

{/* 索引单独放一段 JSON，不走 astro-island 的 props：
    devalue 序列化会把数组膨胀一倍多，这样体积最省，且只出现一份。 */}
<script type="application/json" id="mk-search-index" is:inline set:html={indexJson} />
