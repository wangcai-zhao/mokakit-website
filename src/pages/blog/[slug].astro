---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => !p.data.draft)
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateStr = post.data.publishDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${post.data.title} - 博客 - 摩卡工具箱`}
  description={post.data.description}
  path={`/blog/${post.id}/`}
>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <a
      href="/blog/"
      class="inline-flex items-center gap-1 text-sm opacity-60 hover:opacity-100 hover:text-primary transition-all"
    >
      <Icon name="chevronRight" size={14} class="rotate-180" /> 返回博客
    </a>

    <h1 class="mt-4 text-3xl sm:text-4xl font-bold tracking-tight leading-tight">
      {post.data.title}
    </h1>

    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm opacity-60">
      <span class="flex items-center gap-1">
        <Icon name="calendar" size={14} />
        <time datetime={post.data.publishDate.toISOString().slice(0, 10)}>{dateStr}</time>
      </span>
      {
        post.data.tags.length > 0 && (
          <span class="flex items-center gap-1.5">
            {post.data.tags.map((t) => (
              <span class="badge badge-outline badge-sm">{t}</span>
            ))}
          </span>
        )
      }
    </div>

    <div class="prose-cn mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>
