---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_MAP } from '@/config/categories';
import { TOOL_MAP } from '@/tools/registry';
import { RELEASES_DESC, getChangelogTotals } from '@/data/changelog';
import { TOOLKIT_ROUNDUP, ROUNDUP_META, roundupUrl } from '@/data/toolkit-roundup';
import { itemListLd } from '@/utils/jsonld';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

/**
 * 工具盘点榜：只保留 registry 里真实存在的工具。
 * 查不到就丢掉而不是渲染成死链 —— 工具改名或下线时页面自动收敛，不会留 404。
 */
const roundup = TOOLKIT_ROUNDUP.map((entry) => {
  const tool = TOOL_MAP.get(entry.id);
  if (!tool) return null;
  return { ...entry, tool, url: roundupUrl(entry.id) };
}).filter((x): x is NonNullable<typeof x> => Boolean(x));


// 更新日志板块的数据：取最近一批新增工具做摘要，完整内容在 /changelog/
const { releaseCount, toolCount } = getChangelogTotals();
const latest = RELEASES_DESC[0];
const latestTools = latest.groups
  .flatMap((g) => g.tools)
  .map((t) => {
    const meta = TOOL_MAP.get(t.id);
    if (!meta) return null;
    return {
      id: t.id,
      name: meta.name,
      role: t.role ?? meta.tagline,
      icon: meta.icon,
      categoryName: CATEGORY_MAP.get(meta.category)?.name ?? meta.category,
      url: `/tools/${t.id}/`,
    };
  })
  .filter((x): x is NonNullable<typeof x> => Boolean(x));

/** 摘要区只摆前几个，剩下的用"+N"兜住，不把博客页撑爆 */
const SHOW = 6;
const shownTools = latestTools.slice(0, SHOW);
const restCount = latestTools.length - shownTools.length;
---

<BaseLayout
  title="博客 - 摩卡工具箱 MokaKit"
  description="MokaKit 摩卡工具箱的博客：10 个被低估的免费在线工具评测盘点、AI 时代工具箱的定位与方法论、MCP Server 接入指南、中国本土计算器（个税、五险一金、房贷、契税）使用手册，以及每次新增工具的更新日志与幕后复盘。"
  path="/blog/"
  keywords={['免费在线工具推荐', '在线工具评测', '实用工具箱', 'MokaKit 博客', 'MCP 接入']}
  jsonLd={itemListLd(
    roundup.map((item) => ({
      name: item.tool.name,
      url: item.url,
      description: item.verdict,
    })),
  )}
>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold tracking-tight flex items-center gap-2">
      <Icon name="newspaper" size={28} /> 博客
    </h1>
    <p class="mt-3 text-base opacity-70 leading-relaxed">
      关于「AI 时代的工具箱」的思考、MCP 接入教程，以及中国本土计算器的使用指南。
    </p>

    <!-- 本期工具评测榜：博客页偏「读完就知道该用哪个」，先给结论再给理由 -->
    <section class="mt-10" id="roundup">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-xl font-bold flex items-center gap-2">
          <span class="grid place-items-center w-7 h-7 rounded-lg bg-primary/10 text-primary">
            <Icon name="star" size={16} />
          </span>
          {ROUNDUP_META.title}
        </h2>
        <span class="text-xs opacity-50">
          <span class="badge badge-outline badge-sm mr-1.5">{ROUNDUP_META.column}</span>
          {ROUNDUP_META.date}
        </span>
      </div>

      <p class="mt-3 text-sm opacity-75 leading-relaxed">{ROUNDUP_META.intro}</p>

      <div class="mt-5 flex flex-col gap-3">
        {
          roundup.map((item) => (
            <article class="rounded-2xl border border-base-300 bg-base-100 p-4 sm:p-5 transition-colors duration-200 hover:border-primary/40">
              <div class="flex items-start gap-3">
                <span class="shrink-0 w-7 text-lg font-bold tabular-nums text-primary/40 leading-7 text-center">
                  {String(item.rank).padStart(2, '0')}
                </span>
                <span class="grid place-items-center w-9 h-9 shrink-0 rounded-xl bg-primary/10 text-primary">
                  <Icon name={item.tool.icon} size={18} />
                </span>
                <div class="min-w-0 flex-1">
                  <h3 class="font-bold leading-6">
                    <a
                      href={item.url}
                      class="hover:text-primary hover:underline decoration-dotted underline-offset-4"
                    >
                      {item.tool.name}
                    </a>
                  </h3>
                  <p class="text-xs opacity-60 mt-0.5 line-clamp-1">{item.tool.tagline}</p>
                </div>
                <span
                  class="shrink-0 inline-flex items-baseline gap-0.5 rounded-lg bg-primary/10 px-2 py-1 text-primary"
                >
                  <span class="text-sm font-bold tabular-nums">{item.score.toFixed(1)}</span>
                  <span class="text-[10px] opacity-70">/10</span>
                </span>
              </div>

              <p class="mt-3 text-sm leading-relaxed">
                <span class="text-primary font-medium">评测结论 · </span>
                {item.verdict}
              </p>

              <ul class="mt-2 space-y-1">
                {item.pros.map((pro) => (
                  <li class="flex items-start gap-1.5 text-xs opacity-75 leading-relaxed">
                    <Icon name="check" size={12} class="mt-1 text-primary shrink-0" />
                    <span>{pro}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-3 pt-3 border-t border-base-300 flex flex-wrap items-center gap-x-3 gap-y-1.5">
                <span class="text-xs opacity-60">
                  <span class="opacity-70">适合：</span>
                  {item.bestFor}
                </span>
                <a
                  href={item.url}
                  class="ml-auto text-xs text-primary hover:underline inline-flex items-center gap-0.5"
                >
                  打开工具
                  <Icon name="arrowRight" size={12} />
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <!-- 评测口径说清楚，读者才知道评分不是随手给的 -->
      <div class="mt-4 rounded-2xl border border-base-300 bg-base-200/40 p-4">
        <p class="text-xs leading-relaxed opacity-75">
          <strong class="opacity-100">评分口径：</strong>{ROUNDUP_META.method}
        </p>
        <p class="mt-2 text-xs leading-relaxed opacity-75">
          <strong class="opacity-100">为什么放心用：</strong>
          薪资、卡号、密码这类敏感输入全部在浏览器本地计算，不上传服务器；不强制注册，打开即用。
          想验证「不上传」很简单——断网之后这些页面照样能跑。
        </p>
        <p class="mt-3 text-xs opacity-60">
          想学具体怎么用？
          <a href="/tips/" class="text-primary hover:underline">同一批工具的进阶用法在技巧页 →</a>
        </p>
      </div>
    </section>

    <!-- 更新日志板块：让读者先看到"最近多了什么能力"，再往下读长文 -->
    <section class="mt-9">
      <div class="flex flex-wrap items-baseline justify-between gap-2 mb-3">
        <h2 class="text-xl font-bold flex items-center gap-2">
          <span class="grid place-items-center w-7 h-7 rounded-lg bg-primary/10 text-primary">
            <Icon name="refresh" size={16} />
          </span>
          更新日志
        </h2>
        <a
          href="/changelog/"
          class="text-sm text-primary hover:underline inline-flex items-center gap-0.5"
        >
          全部 {releaseCount} 个批次
          <Icon name="arrowRight" size={14} />
        </a>
      </div>

      <p class="text-sm opacity-70 leading-relaxed mb-3">
        每上线一批新工具都会记一笔：名称、用途、核心功能。目前累计
        <strong class="text-primary">{toolCount}</strong> 个新增工具，最近一批是
        {latest.date} —— {latest.title}。
      </p>

      <div class="rounded-2xl border border-base-300 bg-base-100 p-4">
        <div class="grid gap-2 sm:grid-cols-2">
          {
            shownTools.map((t) => (
              <a
                href={t.url}
                class="group flex items-start gap-2.5 px-3 py-2 rounded-xl border border-base-300 bg-base-100 hover:border-primary/50 hover:shadow-sm transition-all duration-200"
              >
                <span class="grid place-items-center w-7 h-7 shrink-0 rounded-lg bg-primary/10 text-primary mt-0.5">
                  <Icon name={t.icon} size={14} />
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-medium group-hover:text-primary transition-colors">
                    {t.name}
                  </span>
                  <span class="block text-xs opacity-60 mt-0.5 leading-snug line-clamp-2">
                    {t.role}
                  </span>
                </span>
              </a>
            ))
          }
        </div>

        <div class="mt-3 pt-3 border-t border-base-300 flex flex-wrap items-center gap-x-3 gap-y-1.5">
          <a
            href="/changelog/"
            class="text-sm text-primary hover:underline inline-flex items-center gap-1"
          >
            查看完整更新日志{restCount > 0 && `（本批还有 ${restCount} 个）`}
            <Icon name="arrowRight" size={14} />
          </a>
          <span class="text-xs opacity-50">|</span>
          <a href="/tools/" class="text-xs opacity-70 hover:text-primary hover:underline">
            全部工具按分类浏览
          </a>
        </div>
      </div>
    </section>

    <div class="mt-12 mb-4 flex items-center gap-2">
      <h2 class="text-xl font-bold">全部文章</h2>
      <span class="text-xs opacity-50 mt-1">{posts.length} 篇</span>
    </div>

    <div class="mt-6 flex flex-col gap-4">
      {
        posts.length === 0 && (
          <div class="text-center py-16 opacity-60">
            <p>文章正在陆续上线，敬请期待。</p>
          </div>
        )
      }
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="group block rounded-2xl border border-base-300 bg-base-100 p-5 transition-all duration-200 hover:border-primary/50 hover:shadow-md"
          >
            <div class="flex items-center gap-2 text-xs opacity-60">
              <Icon name="calendar" size={14} />
              <time datetime={post.data.publishDate.toISOString().slice(0, 10)}>
                {post.data.publishDate.toLocaleDateString('zh-CN', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              {
                post.data.tags.length > 0 && (
                  <span class="flex items-center gap-1.5 ml-2">
                    {post.data.tags.map((t) => (
                      <span class="badge badge-outline badge-sm">{t}</span>
                    ))}
                  </span>
                )
              }
            </div>
            <h2 class="mt-2 text-xl font-bold group-hover:text-primary transition-colors">
              {post.data.title}
            </h2>
            <p class="mt-1.5 text-sm opacity-70 leading-relaxed">{post.data.description}</p>
            <span class="mt-3 inline-flex items-center gap-0.5 text-sm text-primary opacity-80 group-hover:opacity-100">
              阅读全文
              <Icon name="arrowRight" size={14} />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
