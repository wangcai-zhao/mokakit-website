---
import { SITE, adSlot } from '@/config/site';

/**
 * 广告位占位容器。
 *
 * ⚠️ 关键：无论广告是否开启，容器都必须占据固定高度。
 * 广告异步插入导致的内容跳动（CLS）是广告站性能分数的头号杀手，
 * 也直接影响 Core Web Vitals 排名。
 *
 * 三处开关，优先级从高到低：
 *   ① SITE.ads.enabled       —— 全局总闸
 *   ② SITE.ads.slots[slot]   —— 版位级开关（未登记 = 不投放）
 *   ③ SITE.ads.adsenseClient —— 发布商 ID，空则不请求
 * 三者都通过才会渲染 <ins>。
 *
 * 合规：「广告」标识默认由 SITE.ads.showLabel 控制，绝对定位不占流、不引起 CLS。
 */
interface Props {
  /** 广告位标识，必须已在 SITE.ads.slots 登记，否则不投放 */
  slot: string;
  /** 尺寸预设；不传则用版位登记时的 format */
  format?: 'banner' | 'rectangle' | 'leaderboard';
  class?: string;
}

const { slot, format, class: className = '' } = Astro.props;

const conf = adSlot(slot);
const fmt = format ?? conf.format;

const SIZES = {
  banner: 'min-h-[100px] md:min-h-[90px]',
  rectangle: 'min-h-[250px]',
  leaderboard: 'min-h-[90px] md:min-h-[90px]',
} as const;

const show = Boolean(SITE.ads.enabled && SITE.ads.adsenseClient && conf.enabled);

/**
 * ⚠️ AdSense 只认写在 <ins> 上的 data-ad-client / data-ad-slot，
 * 之前这两个属性漏写（slot 只挂在外层 div 上），结果 adsbygoogle 拿不到配置、
 * 广告位一个都填不出来，只留一块空白。
 */
const insAttrs = {
  class: 'adsbygoogle block w-full',
  style: 'display:block',
  'data-ad-client': SITE.ads.adsenseClient,
  'data-ad-slot': slot,
  'data-ad-format': 'auto',
  'data-full-width-responsive': 'true',
};
---

<div
  class:list={['relative w-full', SIZES[fmt], className]}
  data-ad-slot={slot}
  aria-hidden={!show}
>
  {/* 合规标识：绝对定位，不占文档流，不引入 CLS */}
  {
    show && SITE.ads.showLabel && (
      <span class="absolute right-0 -top-4 text-[10px] leading-none tracking-wider text-base-content/35 select-none">
        广告
      </span>
    )
  }
  {show ? <ins {...insAttrs} /> : null}
  {
    show && (
      <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    )
  }
</div>
