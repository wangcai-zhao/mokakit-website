---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

const title = '投稿：推荐好工具';
const description =
  '向摩卡工具箱推荐你喜欢的在线工具或好站，评估通过后收录进站。GitHub Issue 引导 + 邮件兜底，零后端。';

const gh = SITE.github;
const hasGithub = !!(gh && gh.owner && gh.repo);
const issueBase = hasGithub
  ? `https://github.com/${gh.owner}/${gh.repo}/issues/new`
  : '';
const mailtoBase = `mailto:wangcai@mokakit.com?subject=${encodeURIComponent('【摩卡工具箱投稿】')}`;
---

<BaseLayout title={title} description={description} path="/submit/">
  <section class="mx-auto max-w-2xl px-4 py-10">
    <h1 class="text-2xl font-bold mb-2">推荐一个好工具</h1>
    <p class="text-base-content/60 mb-6">
      发现好用的在线工具或好站？填下面的表单告诉我们，评估通过后收录进摩卡工具箱。
    </p>

    <form id="submit-form" class="space-y-4">
      <div>
        <label class="label"><span class="label-text">工具 / 站点名称 *</span></label>
        <input
          id="f-name"
          required
          class="input input-bordered w-full"
          placeholder="例如：JSON 格式化"
        />
      </div>
      <div>
        <label class="label"><span class="label-text">链接 *</span></label>
        <input
          id="f-url"
          type="url"
          required
          class="input input-bordered w-full"
          placeholder="https://..."
        />
      </div>
      <div>
        <label class="label"><span class="label-text">推荐理由 / 说明</span></label>
        <textarea
          id="f-note"
          rows="4"
          class="textarea textarea-bordered w-full"
          placeholder="它解决了什么问题、为什么好用…"></textarea>
      </div>
      <div class="flex flex-wrap gap-3">
        <button type="submit" id="btn-github" class="btn btn-primary">在 GitHub 提交</button>
        <a id="btn-mail" href={mailtoBase} class="btn btn-outline">发邮件投稿</a>
      </div>
      {
        !hasGithub && (
          <p class="text-sm text-warning">
            GitHub 仓库未配置，已降级为邮件投稿（仓库配好后自动启用 GitHub 通道）。
          </p>
        )
      }
    </form>
  </section>
</BaseLayout>

<script
  is:inline
  define:vars={{ ISSUE_BASE: issueBase, HAS_GH: hasGithub, MAILTO: mailtoBase }}
>
  (function () {
    function val(id) {
      return (document.getElementById(id).value || '').trim();
    }
    function buildBody() {
      var name = val('f-name'),
        url = val('f-url'),
        note = val('f-note');
      return (
        '## 推荐工具\n- 名称：' +
        name +
        '\n- 链接：' +
        url +
        '\n- 推荐理由：\n' +
        note +
        '\n\n（由摩卡工具箱 /submit 页提交）'
      );
    }
    function openIssue() {
      if (!val('f-name') || !val('f-url')) {
        document.getElementById('submit-form').reportValidity();
        return;
      }
      var title = encodeURIComponent('【投稿】' + val('f-name'));
      var body = encodeURIComponent(buildBody());
      window.open(ISSUE_BASE + '?title=' + title + '&body=' + body, '_blank');
    }
    function openMail() {
      if (!val('f-name') || !val('f-url')) {
        document.getElementById('submit-form').reportValidity();
        return;
      }
      var subject = encodeURIComponent('【摩卡工具箱投稿】' + val('f-name'));
      var body = encodeURIComponent(buildBody());
      window.location.href = 'mailto:wangcai@mokakit.com?subject=' + subject + '&body=' + body;
    }

    var btnG = document.getElementById('btn-github');
    var btnM = document.getElementById('btn-mail');
    if (HAS_GH && btnG) {
      btnG.addEventListener('click', function (e) {
        e.preventDefault();
        openIssue();
      });
    } else if (btnG) {
      btnG.style.display = 'none';
    }
    if (btnM) {
      btnM.addEventListener('click', function (e) {
        // 有内容时构造带正文的邮件；否则用静态兜底链接
        if (val('f-name') && val('f-url')) {
          e.preventDefault();
          openMail();
        }
      });
    }
  })();
</script>
