---
import type { ToolMeta } from '@/tools/types';
import Icon from './Icon.astro';

interface Props {
  tool: ToolMeta;
}
const { tool } = Astro.props;
---

<a
  href={`/tools/${tool.id}/`}
  class="group relative flex items-start gap-3 p-4 rounded-2xl bg-base-100 border border-base-300 hover:border-primary/50 hover:shadow-md transition-all duration-200"
>
  <span
    class="grid place-items-center w-10 h-10 shrink-0 rounded-xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-content transition-colors"
  >
    <Icon name={tool.icon} size={20} />
  </span>

  <span class="min-w-0 flex-1">
    <span class="flex items-center gap-1.5">
      <span class="font-semibold truncate">{tool.name}</span>
      {
        tool.status === 'beta' && (
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-warning/20 text-warning-content/80 font-medium shrink-0">
            测试
          </span>
        )
      }
    </span>
    <span class="block text-sm opacity-65 mt-0.5 line-clamp-2 leading-snug">
      {tool.tagline}
    </span>
  </span>

  <Icon
    name="arrowRight"
    size={16}
    class="shrink-0 mt-1 opacity-0 -translate-x-1 group-hover:opacity-60 group-hover:translate-x-0 transition-all"
  />
</a>
