---
import { SITE } from '@/config/site';
import { getToolsByCategory } from '@/tools/registry';

const groups = getToolsByCategory();
const year = new Date().getFullYear();
const copyrightYears = year > SITE.since ? `${SITE.since}-${year}` : `${SITE.since}`;
// 公安备案号只取数字部分拼出全国互联网安全管理服务平台的核验链接
const policeRecordCode = SITE.police ? SITE.police.replace(/\D/g, '') : '';
---

<footer class="bg-base-100 border-t border-base-300 mt-12">
  <div class="mx-auto max-w-6xl px-4 py-8">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <div class="font-bold text-base mb-2">
          {SITE.name}
          <span class="text-xs font-normal opacity-60 ml-1.5">{SITE.nameCn}</span>
        </div>
        <p class="text-sm opacity-70 leading-relaxed">{SITE.slogan}</p>
        <p class="text-xs opacity-60 mt-2 leading-relaxed">
          所有工具均在浏览器本地运行，不上传你的输入数据；仅统计匿名聚合访问量用于改进。
        </p>
      </div>

      {
        groups.slice(0, 3).map((g) => (
          <div>
            <div class="font-semibold text-sm mb-2">
              <a href={`/tools/c/${g.category.slug}/`} class="hover:text-primary">
                {g.category.name}
              </a>
            </div>
            <ul class="space-y-1.5">
              {g.tools.slice(0, 6).map((t) => (
                <li>
                  <a
                    href={`/tools/${t.id}/`}
                    class="text-sm opacity-70 hover:opacity-100 hover:text-primary transition-colors"
                  >
                    {t.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-8 pt-5 border-t border-base-300 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs opacity-70"
    >
      <div>
        © {copyrightYears} {SITE.nameCn} {SITE.name}
        {' '}
        {
          SITE.launched ? (
            <span class="font-mono">{SITE.version}</span>
          ) : (
            <a
              href="/workbench.html"
              class="font-mono hover:text-primary"
              title="查看项目进度工作台"
            >
              {SITE.version}
            </a>
          )
        }
        {
          SITE.counter.enabled && (
            <span id="site-visits" class="ml-2" hidden>
              · 累计访问 <span class="font-semibold">—</span>
            </span>
          )
        }
      </div>
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5">
        <a href="/about/" class="hover:text-primary">关于</a>
        <a href="/privacy/" class="hover:text-primary">隐私政策</a>
        {
          SITE.icp && (
            <a
              href="https://beian.miit.gov.cn/"
              target="_blank"
              rel="nofollow noopener"
              class="hover:text-primary"
            >
              {SITE.icp}
            </a>
          )
        }
        {
          SITE.police && policeRecordCode && (
            <a
              href={`https://beian.gov.cn/portal/registerSystemInfo?recordcode=${policeRecordCode}`}
              target="_blank"
              rel="nofollow noopener"
              class="hover:text-primary"
            >
              {SITE.police}
            </a>
          )
        }
      </div>
    </div>
  </div>

  <script>
    import { bump, keys, fmtCount } from '@/utils/counter';

    const el = document.getElementById('site-visits');
    if (el) {
      const viewKey = keys.view(location.pathname);
      // 记一次本页 PV，同时拿回全站累计总量回填
      bump([viewKey, keys.site]).then((counts) => {
        const n = counts?.[keys.site];
        if (n == null) return;
        const span = el.querySelector('span');
        if (span) span.textContent = fmtCount(n);
        el.hidden = false;
      });
    }
  </script>
</footer>
