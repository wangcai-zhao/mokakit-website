---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolCard from '@/components/ToolCard.astro';
import Icon from '@/components/Icon.astro';
import { SITE } from '@/config/site';
import { INDEXABLE_TOOLS } from '@/tools/registry';

// 404 页面不该被收录，但要给用户和爬虫一条回到正常内容的路
const picks = INDEXABLE_TOOLS.slice(0, 6);
---

<BaseLayout
  title="页面不存在"
  description={`没有找到你要访问的页面，回到${SITE.nameCn}首页看看其他工具。`}
  path="/404.html"
  noindex
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:py-20 text-center">
    <div
      class="mx-auto grid place-items-center w-16 h-16 rounded-2xl bg-primary/10 text-primary"
    >
      <Icon name="search" size={30} />
    </div>

    <h1 class="mt-6 text-3xl sm:text-4xl font-bold tracking-tight">
      这个页面走丢了
    </h1>
    <p class="mt-3 text-base opacity-70 leading-relaxed">
      地址可能输错了，或者这个工具还没上线。换个方式找找看。
    </p>

    <form
      action="/search/"
      method="get"
      class="mt-7 max-w-md mx-auto flex items-center gap-2"
      role="search"
    >
      <label for="nf-search" class="sr-only">搜索工具</label>
      <div class="relative flex-1">
        <span
          class="absolute left-3 top-1/2 -translate-y-1/2 opacity-50 pointer-events-none"
        >
          <Icon name="search" size={18} />
        </span>
        <input
          id="nf-search"
          type="search"
          name="q"
          placeholder="搜索工具，如：密码、换算…"
          class="input input-bordered w-full pl-10 bg-base-100"
          autocomplete="off"
        />
      </div>
      <button type="submit" class="btn btn-primary">搜索</button>
    </form>

    <div class="mt-6 flex items-center justify-center gap-3">
      <a href="/" class="btn btn-sm btn-outline">回首页</a>
      <a href="/tools/" class="btn btn-sm btn-outline">全部工具</a>
    </div>
  </div>

  {
    picks.length > 0 && (
      <div class="mx-auto max-w-6xl px-4 pb-16">
        <h2 class="text-lg font-bold mb-3">大家都在用</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {picks.map((t) => (
            <ToolCard tool={t} />
          ))}
        </div>
      </div>
    )
  }
</BaseLayout>
