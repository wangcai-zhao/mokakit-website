---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { SITE_GROUPS, isHot, metaOf } from '@/data/sites';
import { goUrl } from '@/utils/outbound';
import { faviconOf } from '@/utils/favicon';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return SITE_GROUPS.map((group, i) => ({
    params: { category: group.id },
    props: {
      group,
      prev: SITE_GROUPS[(i - 1 + SITE_GROUPS.length) % SITE_GROUPS.length],
      next: SITE_GROUPS[(i + 1) % SITE_GROUPS.length],
    },
  }));
}) satisfies GetStaticPaths;

const { group, prev, next } = Astro.props;
const title = `${group.name} · 好站导航`;
const description = `${group.desc}：摩卡工具箱精选的 ${group.links.length} 个${group.name}站点，含简介与直达链接，支持关键词即时筛选。`;

/** 精选排前面，其余按名称稳定排序，浏览时不会每次刷新都变位置 */
const links = [...group.links].sort((a, b) => {
  const ha = isHot(a) ? 0 : 1;
  const hb = isHot(b) ? 0 : 1;
  return ha - hb;
});
const meta = metaOf(group);
const hotCount = links.filter(isHot).length;
---

<BaseLayout title={title} description={description} path={`/sites/${group.id}/`}>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <nav class="mb-6 text-sm opacity-60 flex items-center gap-1">
      <a href="/sites/" class="hover:text-primary">好站导航</a>
      <Icon name="chevronRight" size={14} />
      <span class="opacity-80">{group.name}</span>
    </nav>

    <header class="mb-6">
      <h1 class="text-3xl font-bold flex items-center gap-3">
        <span class="grid place-items-center w-12 h-12 rounded-xl bg-primary/10 text-primary">
          <Icon name={group.icon} size={26} />
        </span>
        {group.name}
      </h1>
      <p class="mt-2 opacity-65 max-w-2xl">{group.desc} · 共 {group.links.length} 个站点</p>
      {
        meta.tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-1.5">
            {meta.tags.map((t) => (
              <span class="badge badge-sm badge-outline">{t}</span>
            ))}
            {hotCount > 0 && (
              <span class="badge badge-sm badge-primary badge-outline">
                {hotCount} 个精选
              </span>
            )}
          </div>
        )
      }
    </header>

    <div class="mb-5">
      <label class="input input-bordered flex items-center gap-2 w-full max-w-lg">
        <Icon name="search" size={18} class="opacity-50" />
        <input
          type="search"
          id="link-search"
          class="grow bg-transparent outline-none"
          placeholder={`在「${group.name}」里找站点`}
          autocomplete="off"
        />
      </label>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        links.map((link) => (
          <a
            href={goUrl(link.url)}
            target="_blank"
            rel="noopener noreferrer nofollow"
            data-search={`${link.name} ${link.desc} ${link.tag ?? ''}`.toLowerCase()}
            class="site-link flex items-start gap-3 rounded-xl border border-base-300 bg-base-100 p-4 hover:border-primary hover:shadow-sm transition"
          >
            <span class="relative grid place-items-center w-10 h-10 shrink-0 rounded-lg bg-primary/10 text-primary font-bold overflow-hidden">
              {link.name.charAt(0)}
              <img
                src={faviconOf(link.url)}
                alt=""
                loading="lazy"
                referrerpolicy="no-referrer"
                class="absolute inset-0 w-full h-full object-contain p-1.5 bg-base-100"
                onerror="this.style.display='none'"
              />
            </span>
            <span class="min-w-0 flex-1">
              <span class="flex items-center justify-between gap-2">
                <span class="font-medium truncate inline-flex items-center gap-1">
                  {isHot(link) && <Icon name="star" size={12} class="text-primary shrink-0" />}
                  {link.name}
                </span>
                {link.tag ? (
                  <span class="badge badge-xs badge-ghost shrink-0">{link.tag}</span>
                ) : (
                  <Icon
                    name="arrowRight"
                    size={16}
                    class="opacity-0 group-hover:opacity-60 transition shrink-0"
                  />
                )}
              </span>
              <span class="block text-sm opacity-60 leading-snug mt-0.5">{link.desc}</span>
            </span>
          </a>
        ))
      }
    </div>

    <p id="link-empty" class="hidden text-sm opacity-60 py-8 text-center">
      这个分类里没有匹配的站点，换个关键词或返回看看其它分类。
    </p>

    <nav class="mt-10 grid gap-3 sm:grid-cols-2">
      <a
        href={`/sites/${prev.id}/`}
        class="flex items-center gap-2 rounded-xl border border-base-300 bg-base-100 p-3 hover:border-primary transition"
      >
        <Icon name="chevronRight" size={16} class="rotate-180 opacity-60" />
        <span class="min-w-0">
          <span class="block text-xs opacity-50">上一个分类</span>
          <span class="block truncate text-sm font-medium">{prev.name}</span>
        </span>
      </a>
      <a
        href={`/sites/${next.id}/`}
        class="flex items-center justify-end gap-2 rounded-xl border border-base-300 bg-base-100 p-3 hover:border-primary transition sm:text-right"
      >
        <span class="min-w-0">
          <span class="block text-xs opacity-50">下一个分类</span>
          <span class="block truncate text-sm font-medium">{next.name}</span>
        </span>
        <Icon name="chevronRight" size={16} class="opacity-60" />
      </a>
    </nav>

    <a
      href="/sites/"
      class="mt-6 inline-flex items-center gap-2 text-sm text-primary hover:underline"
    >
      <Icon name="chevronRight" size={16} class="rotate-180" />
      返回全部分类
    </a>
  </div>

  <script is:inline>
    (function () {
      var input = document.getElementById('link-search');
      var empty = document.getElementById('link-empty');
      if (!input) return;
      var cards = Array.prototype.slice.call(document.querySelectorAll('.site-link'));

      input.addEventListener('input', function () {
        var q = (input.value || '').trim().toLowerCase();
        var shown = 0;
        cards.forEach(function (card) {
          var hit = !q || (card.getAttribute('data-search') || '').indexOf(q) !== -1;
          if (hit) shown++;
          if (hit) card.classList.remove('hidden');
          else card.classList.add('hidden');
        });
        if (empty) {
          if (shown === 0) empty.classList.remove('hidden');
          else empty.classList.add('hidden');
        }
      });
    })();
  </script>
</BaseLayout>
