---
/**
 * GitHub / 邮箱图标链接。
 *
 * 导航右侧、移动端菜单、页脚共用这一份，改地址只需动 src/config/site.ts（SOCIAL）。
 * 图标是内联 SVG（Lucide 风格，stroke + currentColor），与 Icon.astro 视觉一致，
 * 不依赖雪碧图，页脚 / 导航任意位置都能直接用。
 *
 * - variant="square"：纯图标方形按钮（导航右侧，最省横向空间）
 * - variant="inline"：图标 + 文字（页脚、移动端菜单，可读性更好）
 */
import { SOCIAL } from '@/config/site';

interface Props {
  variant?: 'square' | 'inline';
  /** 追加到每个 <a> 上的类（如 `hidden sm:inline-flex` 控制响应式显隐） */
  class?: string;
}

const { variant = 'square', class: className = '' } = Astro.props;

const linkBase =
  variant === 'square' ? 'btn btn-ghost btn-sm btn-square' : 'btn btn-ghost btn-sm gap-1.5';

const githubLabel = `MokaKit 源码仓库（GitHub，在新标签页打开）`;
const mailLabel = `给 MokaKit 作者发邮件（${SOCIAL.email}）`;
---

<a
  href={SOCIAL.github}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[linkBase, className]}
  aria-label={githubLabel}
  title="GitHub 源码仓库"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
    ></path>
    <path d="M9 18c-4.51 2-5-2-7-2"></path>
  </svg>
  {variant === 'inline' && <span>GitHub</span>}
</a>

<a
  href={SOCIAL.mailto}
  class:list={[linkBase, className]}
  aria-label={mailLabel}
  title={`邮件联系：${SOCIAL.email}`}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
  </svg>
  {variant === 'inline' && <span>邮箱</span>}
</a>
