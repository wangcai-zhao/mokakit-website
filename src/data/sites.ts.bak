/**
 * 「好站导航」板块的数据源。
 *
 * 设计原则：数据驱动、纯静态、不引入任何后端/CMS（不用 WordPress）。
 * 新增一个推荐站点，只需在这里 push 一条；页面与 sitemap 会自动更新。
 * 站点都是外链，页面里统一加 rel="nofollow"，避免权重外流。
 *
 * icon 用 src/components/Icon.astro 里已有的 Lucide 图标名。
 */
export interface SiteLink {
  /** 站点名称 */
  name: string;
  /** 完整 URL（含协议） */
  url: string;
  /** 一句话简介，≤20 字 */
  desc: string;
}

export interface SiteGroup {
  id: string;
  /** 分组名称 */
  name: string;
  /** 分组副标题 */
  desc: string;
  /** 分组图标（Icon.astro 中的 Lucide 名） */
  icon: string;
  links: SiteLink[];
}

