---
/**
 * ★ 时钟工具沉浸式布局 ★
 *
 * 仿 clockhub.app 的全屏时钟体验：
 * - 舞台区（stage）：100vh 全视口，背景图/主题铺满，时钟居中
 * - SEO 区：舞台下方，包含面包屑、标题、content.mdx、FAQ、相关工具
 *
 * 与 ToolLayout 的区别：
 *   无 Header / Footer / 工具卡片边框
 *   时钟组件直接占据整个视口
 *   SEO 内容在下方滚动区域，对搜索引擎友好
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import ToolCard from '@/components/ToolCard.astro';
import AdSlot from '@/components/AdSlot.astro';
import Icon from '@/components/Icon.astro';
import type { ToolMeta, FaqItem } from '@/tools/types';
import { getCategory } from '@/config/categories';
import { SITE, absUrl } from '@/config/site';
import { getRelatedTools } from '@/tools/registry';
import { breadcrumbLd, faqLd, toolLd, type Crumb } from '@/utils/jsonld';

interface Props {
  tool: ToolMeta;
  title?: string;
  description?: string;
  path?: string;
  extraCrumbs?: Crumb[];
  faq?: FaqItem[];
  noindex?: boolean;
}

const {
  tool,
  title,
  description,
  path,
  extraCrumbs = [],
  faq,
  noindex,
} = Astro.props;

const category = getCategory(tool.category);
const url = path ?? `/tools/${tool.id}/`;
const pageTitle = title ?? `${tool.name} - 在线免费全屏时钟`;
const pageDesc = description ?? tool.description;
const faqItems = faq ?? tool.faq ?? [];
const related = getRelatedTools(tool, 4);

const crumbs: Crumb[] = [
  { name: '首页', url: '/' },
  { name: '工具', url: '/tools/' },
  { name: category.name, url: `/tools/c/${category.slug}/` },
  { name: tool.name, url: `/tools/${tool.id}/` },
  ...extraCrumbs,
];

const jsonLd: Record<string, unknown>[] = [toolLd(tool, url), breadcrumbLd(crumbs)];
if (faqItems.length > 0) jsonLd.push(faqLd(faqItems));
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  path={url}
  keywords={tool.keywords}
  jsonLd={jsonLd}
  noindex={noindex ?? tool.noindex}
  immersive={true}
>
  {/* ====== 沉浸式舞台：时钟组件全视口 ====== */}
  {/* 物理深色兜底：即便 JS 背景层未渲染，底色也是深色，白字绝不隐形 */}
  {/* isolation: 把内部所有定位（背景/顶栏）的堆叠上下文锁死在舞台内，绝不外溢盖住正文 */}
  <div id="ck-immersive-stage" style="position:relative;width:100%;height:100vh;overflow:hidden;background:#0b0b16;isolation:isolate">
    <slot name="clock" />
    {/* 向下滚动提示：首屏满屏，引导用户发现下方说明 */}
    <a
      href="#ck-seo"
      aria-label="向下滚动查看工具说明"
      style="position:absolute;bottom:1.1rem;left:50%;transform:translateX(-50%);z-index:60;display:flex;flex-direction:column;align-items:center;gap:0.15rem;color:rgba(255,255,255,0.72);font-size:0.72rem;letter-spacing:0.04em;text-decoration:none;animation:ck-bounce 1.8s ease-in-out infinite;cursor:pointer;"
    >
      <span>向下滚动查看说明</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </a>
  </div>

  <style is:global>
    @keyframes ck-bounce {
      0%, 100% { transform: translateX(-50%) translateY(0); }
      50% { transform: translateX(-50%) translateY(6px); }
    }
  </style>

  {/* ====== SEO 内容区：舞台下方 ====== */}
  <div id="ck-seo" style="position:relative;z-index:1" class="mx-auto max-w-4xl px-4 py-8">
    <Breadcrumb crumbs={crumbs} />

    <header class="mt-4 mb-5">
      <div class="flex items-start gap-3 justify-between">
        <div class="flex items-start gap-3 min-w-0">
          <span
            class="grid place-items-center w-11 h-11 shrink-0 rounded-xl bg-primary/10 text-primary"
          >
            <Icon name={tool.icon} size={22} />
          </span>
          <div class="min-w-0">
            <h1 class="text-2xl sm:text-3xl font-bold leading-tight">
              {title ?? tool.name}
            </h1>
            <p class="text-sm opacity-70 mt-1">{tool.tagline}</p>
            {
              SITE.counter.enabled && (
                <p id="tool-use-count" class="text-xs opacity-60 mt-2" hidden>
                  已被使用 <span class="font-semibold text-primary">—</span> 次
                </p>
              )
            }
          </div>
        </div>
        {
          SITE.share.enabled && (
            <button
              id="tool-share-btn"
              type="button"
              class="btn btn-ghost btn-sm btn-square shrink-0"
              aria-label="分享这个工具"
              title="分享"
              data-share-title={pageTitle}
              data-share-url={absUrl(url)}
            >
              <Icon name="share-2" size={18} />
            </button>
          )
        }
      </div>
    </header>

    <AdSlot slot="tool-below" format="banner" class="my-6" />

    {/* 说明长文 */}
    <article class="prose-cn mt-2">
      <slot name="content" />
    </article>

    {
      faqItems.length > 0 && (
        <section class="mt-8" aria-labelledby="faq-heading">
          <h2 id="faq-heading" class="text-xl font-bold mb-3">
            常见问题
          </h2>
          <div class="space-y-2">
            {faqItems.map((f) => (
              <details class="group rounded-xl bg-base-100 border border-base-300 overflow-hidden">
                <summary class="cursor-pointer list-none px-4 py-3 font-medium flex items-center justify-between gap-3 hover:bg-base-200 transition-colors">
                  <span>{f.q}</span>
                  <Icon
                    name="chevronRight"
                    size={16}
                    class="shrink-0 opacity-50 transition-transform group-open:rotate-90"
                  />
                </summary>
                <div class="px-4 pb-3 pt-1 text-sm opacity-80 leading-relaxed">
                  {f.a}
                </div>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-8" aria-labelledby="related-heading">
          <h2 id="related-heading" class="text-xl font-bold mb-3">
            相关工具
          </h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {related.map((t) => (
              <ToolCard tool={t} />
            ))}
          </div>
        </section>
      )
    }

    <div class="mt-10 text-center">
      <a href="/tools/" class="text-sm text-primary hover:underline">← 查看摩卡工具箱全部工具</a>
    </div>
  </div>

  <script>
    // 纯内联实现，不用 import（避免 "Cannot use import statement outside a module" 致命错误）
    (function() {
      const toolId = /* @json {toolId} */ '';

      /* ---- 计数器（仅生产环境；dev 模式 /api/counter 不存在） ---- */
      const useEl = document.getElementById('tool-use-count');
      const isDev = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
      const counterApi = '/api/counter';

      function getCount(key) {
        return fetch(counterApi + '?action=get&key=' + encodeURIComponent(key))
          .then(r => r.json()).then(d => d?.count ?? null).catch(() => null);
      }
      function bumpCount(key) {
        return fetch(counterApi, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'bump', key })
        }).then(r => r.json()).catch(() => null);
      }
      function fmtCount(n) {
        if (n == null) return '';
        if (n >= 10000) return (n / 10000).toFixed(1) + '万';
        return String(n);
      }

      if (useEl && !isDev) {
        getCount('use:' + toolId).then((n) => {
          if (n == null) return;
          const span = useEl.querySelector('span');
          if (span) span.textContent = fmtCount(n);
          useEl.hidden = false;
        });
      }

      let used = false;
      const onFirstUse = () => {
        if (used || isDev) return;
        used = true;
        const key = 'use:' + toolId;
        bumpCount(key).then((b) => {
          const n = b?.[key];
          if (useEl && n != null) {
            const span = useEl.querySelector('span');
            if (span) span.textContent = fmtCount(n);
            useEl.hidden = false;
          }
        });
        document.removeEventListener('click', onFirstUse, true);
        document.removeEventListener('input', onFirstUse, true);
        document.removeEventListener('change', onFirstUse, true);
      };
      document.addEventListener('click', onFirstUse, true);
      document.addEventListener('input', onFirstUse, true);
      document.addEventListener('change', onFirstUse, true);

      /* ---- 分享按钮 ---- */
      const shareBtn = document.getElementById('tool-share-btn');
      if (shareBtn) {
        const shareUrl = shareBtn.getAttribute('data-share-url') || location.href;
        const shareTitle = shareBtn.getAttribute('data-share-title') || document.title;
        shareBtn.addEventListener('click', async () => {
          try {
            if (navigator.share) {
              await navigator.share({ title: shareTitle, url: shareUrl });
              return;
            }
          } catch { /* 用户取消 */ }
          try {
            await navigator.clipboard.writeText(shareUrl);
            flashCopied(shareBtn);
          } catch { /* 静默 */ }
        });
      }

      function flashCopied(btn) {
        const old = btn.getAttribute('title');
        btn.setAttribute('title', '链接已复制');
        btn.classList.add('text-primary');
        setTimeout(() => {
          if (old != null) btn.setAttribute('title', old);
          btn.classList.remove('text-primary');
        }, 1500);
      }
    })();
  </script>
</BaseLayout>
