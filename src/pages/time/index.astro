---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolCard from '@/components/ToolCard.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import Icon from '@/components/Icon.astro';
import { TOOL_MAP } from '@/tools/registry';
import { TIME_GROUPS } from '@/data/timeDate';
import type { ToolMeta } from '@/tools/types';
import { breadcrumbLd, itemListLd, type Crumb } from '@/utils/jsonld';

const url = '/time/';

const crumbs: Crumb[] = [
  { name: '首页', url: '/' },
  { name: '时间日期', url },
];

const groups = TIME_GROUPS.map((g) => ({
  ...g,
  tools: g.toolIds
    .map((id) => TOOL_MAP.get(id))
    .filter((t): t is ToolMeta => Boolean(t)),
}));

const allTools = groups.flatMap((g) => g.tools);

const jsonLd = [
  breadcrumbLd(crumbs),
  itemListLd(
    allTools.map((t) => ({
      name: t.name,
      url: `/tools/${t.id}/`,
      description: t.tagline,
    })),
  ),
];
---

<BaseLayout
  title="时间日期工具 · 时钟/倒计时/日期计算/时区换算聚合"
  description="摩卡工具箱时间日期专题：数字时钟、翻页时钟、世界时钟、日期计算器、天数差、时区换算、倒计时、时间戳与 Cron 解析。一个入口汇集全部时间与日期工具，全部本地运行、零数据上传。"
  path={url}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-4 py-5">
    <Breadcrumb crumbs={crumbs} />

    <!-- Hero：实时时钟 + 日期 -->
    <section
      class="mt-4 rounded-3xl p-8 sm:p-14 text-center text-white overflow-hidden relative"
      style="background:radial-gradient(120% 120% at 50% 0%,#1e293b 0%,#0f172a 55%,#08080f 100%)"
    >
      <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(60% 50% at 50% 38%,rgba(56,189,248,0.18),transparent 70%)"></div>
      <div class="pointer-events-none absolute inset-0" style="background:radial-gradient(ellipse at center,transparent 42%,rgba(0,0,0,0.5) 100%)"></div>
      <div class="relative z-10">
        <p class="text-sm opacity-70 mb-2">摩卡工具箱 · 时间日期专题</p>
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">时间、日期，一站搞定</h1>
        <p class="mt-3 max-w-2xl mx-auto text-sm opacity-75 leading-relaxed">
          看时间、算日期、转时区、倒数计时——所有与时间相关的工具都收在这里。
          点一下直达，全部在你的浏览器里完成，干净、免费、不上传任何数据。
        </p>

        <div class="mt-8 flex flex-col items-center">
          <div
            id="time-hero-time"
            class="font-mono font-bold tracking-tight tabular-nums leading-none"
            style="font-size:clamp(3rem,14vw,8rem);text-shadow:0 0 26px rgba(56,189,248,0.55),0 0 60px rgba(56,189,248,0.4)"
          >
            --:--:--
          </div>
          <div id="time-hero-date" class="mt-3 text-sm sm:text-base opacity-75"></div>
        </div>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/tools/digital-clock/" class="btn btn-primary">打开数字时钟</a>
          <a href="/tools/date-calculator/" class="btn btn-outline btn-light">日期计算器</a>
          <a href="/tools/countdown-timer/" class="btn btn-outline btn-light">倒计时</a>
        </div>
      </div>
    </section>

    <!-- 分组工具清单 -->
    {
      groups.map((g) => (
        <section class="mt-10">
          <div class="flex items-center gap-2 mb-1">
            <span class="grid place-items-center w-7 h-7 rounded-lg bg-primary/10 text-primary">
              <Icon name={g.icon} size={16} />
            </span>
            <h2 class="text-xl font-bold">{g.title}</h2>
          </div>
          <p class="text-sm opacity-70 mb-4 ml-9">{g.desc}</p>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {g.tools.map((t) => (
              <ToolCard tool={t} />
            ))}
          </div>
        </section>
      ))
    }

    <div class="mt-10 text-center">
      <a href="/tools/" class="text-sm text-primary hover:underline">← 查看摩卡工具箱全部工具</a>
    </div>
  </div>
</BaseLayout>

<script>
  (function () {
    var t = document.getElementById('time-hero-time');
    var d = document.getElementById('time-hero-date');
    function pad(n: number) {
      return String(n).padStart(2, '0');
    }
    function tick() {
      var now = new Date();
      if (t) t.textContent = pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
      if (d)
        d.textContent = now.toLocaleDateString('zh-CN', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          weekday: 'long',
        });
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>
