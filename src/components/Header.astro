---
import { SITE } from '@/config/site';
import { CATEGORIES } from '@/config/categories';
import Icon from './Icon.astro';
import { getToolsByCategory } from '@/tools/registry';

const activeCategoryIds = new Set(getToolsByCategory().map((g) => g.category.id));
const navCategories = CATEGORIES.filter((c) => activeCategoryIds.has(c.id));
const pathname = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 bg-base-100/85 backdrop-blur-md border-b border-base-300"
>
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex h-14 items-center gap-3">
      <a
        href="/"
        class="flex items-center gap-2 font-bold text-lg shrink-0 hover:opacity-80 transition-opacity"
      >
        <span
          class="grid place-items-center w-8 h-8 rounded-lg bg-primary text-primary-content"
        >
          <Icon name="coffee" size={18} />
        </span>
        <span class="leading-none">
          <span>{SITE.name}</span>
          <span class="hidden sm:inline text-xs font-normal opacity-55 ml-1.5"
            >{SITE.nameCn}</span
          >
        </span>
      </a>

      <nav class="hidden md:flex items-center gap-1 ml-2" aria-label="主导航">
        <a
          href="/tools/"
          class:list={[
            'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors hover:bg-base-200',
            pathname.startsWith('/tools') && 'text-primary bg-base-200',
          ]}>全部工具</a
        >
        <a
          href="/sites/"
          class:list={[
            'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors hover:bg-base-200',
            pathname.startsWith('/sites') && 'text-primary bg-base-200',
          ]}>好站导航</a
        >
        <a
          href="/agents/"
          class:list={[
            'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors hover:bg-base-200',
            pathname.startsWith('/agents') && 'text-primary bg-base-200',
          ]}>智能体</a
        >
        <a
          href="/blog/"
          class:list={[
            'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors hover:bg-base-200',
            pathname.startsWith('/blog') && 'text-primary bg-base-200',
          ]}>博客</a
        >
        <a
          href="/developers/"
          class:list={[
            'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors hover:bg-base-200',
            pathname.startsWith('/developers') && 'text-primary bg-base-200',
          ]}>开发者</a
        >
        <a
          href="/time/"
          class:list={[
            'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors hover:bg-base-200',
            pathname.startsWith('/time') && 'text-primary bg-base-200',
          ]}>时间日期</a
        >
        {
          navCategories.slice(0, 4).map((c) => (
            <a
              href={`/tools/c/${c.slug}/`}
              class:list={[
                'px-3 py-1.5 rounded-lg text-sm font-medium transition-colors hover:bg-base-200',
                pathname.startsWith(`/tools/c/${c.slug}`) && 'text-primary bg-base-200',
              ]}
            >
              {c.name}
            </a>
          ))
        }
      </nav>

      <div class="flex-1"></div>

      <a
        href="/search/"
        class="btn btn-ghost btn-sm btn-square"
        aria-label="搜索工具"
      >
        <Icon name="search" size={18} />
      </a>

      <button
        id="theme-toggle"
        class="btn btn-ghost btn-sm btn-square"
        aria-label="切换深色/浅色主题"
        type="button"
      >
        <Icon name="sun" size={18} class="hidden dark-hide" />
        <Icon name="moon" size={18} class="dark-show" />
      </button>

      <button
        id="mobile-menu-btn"
        class="btn btn-ghost btn-sm btn-square md:hidden"
        aria-label="打开菜单"
        aria-expanded="false"
        type="button"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>

    <nav
      id="mobile-menu"
      class="hidden md:hidden pb-3 border-t border-base-300 pt-3"
      aria-label="移动端导航"
    >
      <div class="grid grid-cols-2 gap-1.5">
        <a href="/tools/" class="px-3 py-2 rounded-lg text-sm hover:bg-base-200"
          >全部工具</a
        >
        <a href="/sites/" class="px-3 py-2 rounded-lg text-sm hover:bg-base-200"
          >好站导航</a
        >
        <a href="/agents/" class="px-3 py-2 rounded-lg text-sm hover:bg-base-200"
          >智能体</a
        >
        <a href="/blog/" class="px-3 py-2 rounded-lg text-sm hover:bg-base-200"
          >博客</a
        >
        <a href="/developers/" class="px-3 py-2 rounded-lg text-sm hover:bg-base-200"
          >开发者</a
        >
        <a href="/time/" class="px-3 py-2 rounded-lg text-sm hover:bg-base-200"
          >时间日期</a
        >
        {
          navCategories.map((c) => (
            <a
              href={`/tools/c/${c.slug}/`}
              class="px-3 py-2 rounded-lg text-sm hover:bg-base-200"
            >
              {c.name}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</header>

<style>
  /* 用 CSS 而非 JS 控制图标显隐，避免水合闪烁 */
  :global([data-theme='toolbox']) .dark-show {
    display: none;
  }
  :global([data-theme='toolbox']) .dark-hide {
    display: block !important;
  }
  :global([data-theme='toolboxdark']) .dark-show {
    display: block;
  }
  :global([data-theme='toolboxdark']) .dark-hide {
    display: none !important;
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme');
        var next = cur === 'toolboxdark' ? 'toolbox' : 'toolboxdark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      });
    }

    var mBtn = document.getElementById('mobile-menu-btn');
    var mMenu = document.getElementById('mobile-menu');
    if (mBtn && mMenu) {
      mBtn.addEventListener('click', function () {
        var open = mMenu.classList.toggle('hidden');
        mBtn.setAttribute('aria-expanded', String(!open));
      });
    }
  })();
</script>
